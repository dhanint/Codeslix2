<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView android:id="@+id/tvStatus"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Tempelkan tag…" android:textStyle="bold" android:paddingBottom="6dp"/>

    <!-- pengaturan token -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <RadioGroup android:id="@+id/rgFw" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <RadioButton android:id="@+id/rbV14" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="V1.4" android:checked="true"/>
            <RadioButton android:id="@+id/rbV18" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="V1.8"/>
        </RadioGroup>
    </LinearLayout>

    <EditText android:id="@+id/etKey" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="MASTER_KEY (hex 32 byte)" android:fontFamily="monospace" android:textSize="13sp" android:inputType="textNoSuggestions"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <EditText android:id="@+id/etProduct" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:hint="Kode produk (teks)" android:text="0031" android:textSize="13sp" android:inputType="textNoSuggestions"/>
        <EditText android:id="@+id/etCounter" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:hint="Counter" android:text="0" android:textSize="13sp" android:inputType="textNoSuggestions"/>
    </LinearLayout>
    <EditText android:id="@+id/etTx" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="V1.8: data transmisi blok 32–51 (hex 80 byte)" android:fontFamily="monospace" android:textSize="12sp" android:inputType="textNoSuggestions"/>

    <!-- aksi -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/btnRead" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Read Tag" android:textSize="11sp"/>
        <Button android:id="@+id/btnSysInfo" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Sys Info" android:textSize="11sp"/>
        <Button android:id="@+id/btnNxp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="NXP Sys" android:textSize="11sp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/btnSig" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Signature" android:textSize="11sp"/>
        <Button android:id="@+id/btnToken" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Hitung Token" android:textSize="11sp"/>
        <Button android:id="@+id/btnClear" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Clear" android:textSize="11sp"/>
    </LinearLayout>

    <!-- perintah bebas -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <EditText android:id="@+id/etRaw" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:hint="frame: 02 20 48" android:fontFamily="monospace" android:textSize="13sp" android:inputType="textNoSuggestions"/>
        <Button android:id="@+id/btnSend" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Send"/>
    </LinearLayout>

    <!-- mode tampilan grid -->
    <RadioGroup android:id="@+id/rgDisp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
        <RadioButton android:id="@+id/rbHex" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HEX" android:checked="true"/>
        <RadioButton android:id="@+id/rbAscii" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ASCII"/>
        <RadioButton android:id="@+id/rbDec" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DEC"/>
    </RadioGroup>

    <!-- console log -->
    <ScrollView android:id="@+id/svLog" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="3">
        <TextView android:id="@+id/tvLog" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="monospace" android:textSize="11sp" android:padding="6dp"/>
    </ScrollView>

    <!-- grid blok -->
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="2">
        <TableLayout android:id="@+id/tlBlocks" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </ScrollView>

</LinearLayout>
